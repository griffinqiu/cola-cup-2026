<% on_settlements = controller_name == "settlements" %>
<% records_active = on_settlements && params[:tab] == "records" %>
<% todo_active = on_settlements && !records_active %>
<div class="subtabs">
  <%= link_to "#{t(".todo")}#{" (#{@todo.size})" if @todo&.any?}", admin_root_path, class: ("on" if todo_active) %>
  <%= link_to t(".records"), admin_root_path(tab: "records"), class: ("on" if records_active) %>
  <%= link_to t(".users"), admin_users_path, class: ("on" if controller_name == "users") %>
  <%= link_to t(".jobs"), mission_control_jobs_path, target: "_blank", rel: "noopener" %>
</div>
