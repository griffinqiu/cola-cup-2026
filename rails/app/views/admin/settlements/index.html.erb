<% records_active = params[:tab] == "records" %>
<section>
  <%= turbo_stream_from "admin", I18n.locale %>
  <div class="adm-head">
    <h1>⚙️ <%= t(".title") %></h1>
    <p><%= t(".intro") %></p>
  </div>
  <%= render "admin/shared/tabs" %>
  <hr class="rule ink">

  <% if (notice = flash[:notice]) %>
    <p class="adm-msg">✅ <%= notice %></p>
  <% elsif (alert = flash[:alert]) %>
    <p class="adm-msg">❌ <%= alert %></p>
  <% end %>

  <% if records_active %>
    <% if @records.empty? %>
      <p class="adm-empty"><%= t(".no_records") %></p>
    <% else %>
      <%= render partial: "admin/settlements/record_card", collection: @records, as: :record %>
    <% end %>

    <%= render "admin/settlements/outright", groups: @outright_groups,
          can_open: @golden_boot_can_open, gb_pending: @golden_boot_pending %>
  <% else %>
    <% if @todo.empty? %>
      <p class="adm-empty"><%= t(".no_todo") %></p>
    <% else %>
      <div data-controller="settle-select">
        <%= render partial: "admin/settlements/todo_row", collection: @todo, as: :match,
              locals: { tallies: @tallies } %>

        <%= form_with url: preview_admin_settlements_path, method: :post, id: "settle_form" do %>
          <div class="adm-bar" data-settle-select-target="bar" hidden>
            <button type="submit" class="cta"><%= t(".settle_selected_prefix") %><span data-settle-select-target="count">0</span><%= t(".settle_selected_suffix") %></button>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%# Turbo Stream target for the preview modal (filled on settle action). %>
  <div id="admin_preview"></div>
</section>
