<div class="adm-outright">
  <hr class="rule ink">
  <h2 style="margin:8px 0">👑 <%= t(".heading") %></h2>

  <% if gb_pending %>
    <%= button_to "⚽ #{t(".golden_boot_open")}", admin_golden_boot_open_path,
          method: :post, class: "cta", disabled: !can_open, form: { style: "margin:8px 0" } %>
    <% unless can_open %>
      <p class="adm-note" style="color:var(--low);font-size:12px"><%= t(".final_required") %></p>
    <% end %>
  <% end %>

  <% if groups.empty? %>
    <p class="adm-empty"><%= t(".empty") %></p>
  <% else %>
    <% groups.each do |subject_key, entries| %>
      <% top = entries.first %>
      <% winners = entries.count { |entry| entry.delta.positive? } %>
      <% moved = entries.sum { |entry| [ 0.0, entry.delta ].max } %>
      <details class="adm-rec">
        <summary class="head">
          <span>
            <span class="id"><%= outright_market_icon(top.market) %> <%= top.team&.flag %> <%= top.subject_label %></span>
            <span class="when"><%= outright_result_label(top.market, top.outcome) %> · <%= format_kickoff(top.settled_at) %></span>
          </span>
          <span class="meta">
            <%= t(".people", count: entries.size) %> · <%= t(".bottles", count: bottles_label(moved)) %> ·
            <%= top.settled_by ? t(".settled_by", name: top.settled_by.nickname) : t(".settled_auto") %>
          </span>
        </summary>
        <div class="body">
          <% if winners.zero? %>
            <p class="adm-empty"><%= t(".no_counterparty") %></p>
          <% end %>
          <% entries.sort_by { |entry| -entry.delta }.each do |entry| %>
            <div class="adm-pay">
              <span class="who">
                <%= entry.user&.emoji.presence || "🙂" %> <%= entry.user&.nickname || "?" %> · <%= t(".bet_verb") %><%= outright_pick_label(entry.pick) %>
              </span>
              <span class="amt">
                <span class="<%= entry.delta.positive? ? "recv" : entry.delta.negative? ? "owe" : "zero" %>">
                  <%= t(".bottles", count: format_bottles(entry.delta)) %>
                </span>
              </span>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
  <% end %>
</div>
