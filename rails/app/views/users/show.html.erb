<section>
  <div class="subtabs">
    <%= link_to t("users_views.show.back_to_leaderboard"), leaderboard_path %>
  </div>
  <div class="me">
    <div class="who">
      <span class="em"><%= @user.emoji || "👤" %></span>
      <span>
        <div class="nm disp"><%= @user.nickname %></div>
        <div class="tag"><%= t("users_views.show.participation", count: @ledger.size, wins: @wins) %></div>
      </span>
    </div>
  </div>

  <hr class="rule">
  <div class="ledh disp"><%= t("users_views.show.ledger_heading") %></div>
  <hr class="rule">
  <% if @ledger.empty? %>
    <p style="padding:32px 0;text-align:center;color:var(--low);font-size:13px"><%= t("users_views.show.empty_ledger") %></p>
  <% else %>
    <%= render "profiles/ledger", ledger: @ledger %>
  <% end %>

  <% if @outright_ledger.any? %>
    <div class="ledh disp"><%= t("users_views.show.outright_heading") %></div>
    <hr class="rule">
    <%= render "profiles/outright_ledger", ledger: @outright_ledger %>
  <% end %>

  <%= render "profiles/redemption_records", redemptions: @redemptions %>
</section>
