<section>
  <div class="about">
    <h1 class="lead-h disp">
      <%= t(".lead_heading_html") %>
    </h1>
    <p class="intro">
      <%= t(".intro_html") %>
    </p>

    <div class="sec">
      <h2 class="disp"><%= t(".credits_heading") %></h2>
      <p class="sub"><%= t(".credits_sub") %></p>
      <div class="drinks">
        <div class="drink unit">
          <div class="head">
            <div class="em">🥤</div>
            <div class="dn"><%= t(".drink_cola") %></div>
          </div>
          <div class="note"><%= t(".drink_cola_rate") %></div>
        </div>
        <div class="drink">
          <div class="head">
            <div class="em">🧋</div>
            <div class="dn"><%= t(".drink_tea") %></div>
          </div>
          <div class="note"><%= t(".drink_tea_rate") %></div>
        </div>
        <div class="drink">
          <div class="head">
            <div class="em">👽</div>
            <div class="dn"><%= t(".drink_alien") %></div>
          </div>
          <div class="note"><%= t(".drink_alien_rate") %></div>
        </div>
        <div class="drink">
          <div class="head">
            <div class="em">🐂</div>
            <div class="dn"><%= t(".drink_redbull") %></div>
          </div>
          <div class="note"><%= t(".drink_redbull_rate") %></div>
        </div>
      </div>
    </div>

    <div class="sec">
      <h2 class="disp"><%= t(".how_heading") %></h2>
      <ol class="rules">
        <li>
          <span class="t">
            <%= t(".rule_predict_html") %>
          </span>
        </li>
        <li>
          <span class="t">
            <%= t(".rule_lock_html") %>
          </span>
        </li>
        <li>
          <span class="t">
            <%= t(".rule_settle_html") %>
          </span>
        </li>
        <li>
          <span class="t">
            <%= t(".rule_redeem_html") %>
          </span>
        </li>
        <li>
          <span class="t">
            <%= t(".rule_multi_html") %>
          </span>
        </li>
      </ol>
    </div>
  </div>
</section>
