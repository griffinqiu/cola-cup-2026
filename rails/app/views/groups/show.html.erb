<% content_for :title, t(".page_title", group: @group.name) %>
<section>
  <div class="detail-head">
    <%= link_to root_path, class: "back-btn", data: { controller: "back", action: "click->back#go" } do %>
      <span class="bk-arrow">←</span> <%= t(".back") %>
    <% end %>
    <%= link_to t(".third_place_crumb"), third_place_path, class: "detail-crumb" %>
  </div>
  <hr class="rule ink">

  <div class="lbh">
    <h1 class="disp"><%= @group.name %></h1>
    <div class="sub"><%= t(".subtitle") %></div>
  </div>

  <%= render "standings/table", group: @group %>

  <div class="daylabel"><span class="big"><%= t(".group_results") %></span></div>
  <hr class="rule">
  <%= render "matches/match_list", matches: @group.matches %>
</section>
