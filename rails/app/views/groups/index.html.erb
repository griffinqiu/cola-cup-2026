<% content_for :title, t(".page_title") %>
<section>
  <div class="detail-head">
    <%= link_to root_path, class: "back-btn", data: { controller: "back", action: "click->back#go" } do %>
      <span class="bk-arrow">←</span> <%= t(".back") %>
    <% end %>
    <%= link_to t(".third_place_crumb"), third_place_path, class: "detail-crumb" %>
    <%= link_to t(".scorers_crumb"), scorers_path, class: "detail-crumb" %>
  </div>
  <hr class="rule ink">

  <div class="lbh">
    <h1 class="disp"><%= t(".heading") %></h1>
    <div class="sub"><%= t(".subtitle") %></div>
  </div>

  <% if @groups.empty? %>
    <p class="standings-empty"><%= t(".empty") %></p>
  <% else %>
    <div class="st-legend">
      <span><i class="dot qual"></i><%= t(".legend_qualified") %></span>
      <span><i class="dot third"></i><%= t(".legend_third") %></span>
    </div>
    <% @groups.each do |group| %>
      <div class="daylabel">
        <span class="big"><%= group.name %></span>
        <%= link_to t(".view_group"), group_path(group.letter), class: "sm" %>
      </div>
      <%= render "standings/table", group: group, legend: false %>
    <% end %>
  <% end %>
</section>
