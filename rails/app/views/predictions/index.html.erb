<% content_for :title, t(".page_title") %>
<section>
  <%= turbo_stream_from "predictions", I18n.locale %>
  <div class="masthead">
    <h1 class="headline disp">
      <%= t(".who_champion_html") %> 👑<br>
      <%= t(".who_golden_boot_html") %> ⚽
    </h1>
    <p class="tagline">
      <%= t(".tagline") %>
      <%= link_to t(".what_is_cola"), about_path %>
    </p>
  </div>

  <hr class="rule ink">

  <% if @my_pick_count.to_i.positive? %>
    <p class="pred-mine"><%= t(".mine_html", bottles: bottles_count(@my_bottles), count: @my_pick_count) %></p>
  <% end %>

  <%= render "predictions/status", available: @available %>

  <div class="subtabs">
    <% [ [ "champion", "👑 #{t(".tab_champion")}" ], [ "golden_boot", "⚽ #{t(".tab_golden_boot")}" ] ].each do |value, label| %>
      <%= link_to label, predictions_path(tab: value), class: ("on" if @tab == value) %>
    <% end %>
  </div>

  <% if @yes_count.to_i >= 3 %>
    <p class="pred-warn">
      <%= t(".warn_lead_html", count: @yes_count) %><%= @tab == "golden_boot" ? t(".warn_subject_golden_boot") : t(".warn_subject_champion") %><%= t(".warn_dash") %>
      <%= @tab == "golden_boot" ? t(".warn_target_golden_boot") : t(".warn_target_champion") %><%= t(".warn_tail") %>
    </p>
  <% end %>

  <% if !@available %>
    <%= render "predictions/rules" %>
  <% elsif @rows.empty? %>
    <p class="schedule-empty" style="padding:40px 0;text-align:center;color:var(--low);font-size:13px;">
      <%= @tab == "golden_boot" ? t(".empty_golden_boot") : t(".empty_champion") %>
    </p>
  <% else %>
    <div id="outright_list" class="outrights">
      <%= render partial: "predictions/candidate", collection: @rows, as: :row %>
    </div>
  <% end %>
</section>
