<% subject = row.subject %>
<% tally = row.tally %>
<% market = subject.market %>
<% champion = market == "champion" %>
<% yes = tally.yes %>
<% no = tally.no %>
<% total = yes + no %>
<% current_stake = (row.my_stake || OutrightPick::DEFAULT_STAKE).to_i %>
<div class="ocard" id="<%= outright_dom_id(market, subject.subject_key) %>">
  <div class="ocard-top">
    <span class="ocard-flag"><%= subject.team&.flag.presence || (champion ? "🏳️" : "👤") %></span>
    <% if subject.team %>
      <%# Same as a match page: the name opens the team's schedule (upcoming matches). %>
      <%= link_to team_path(subject.team), class: "ocard-name" do %><%= subject.display_label %> <span class="oname-go">›</span><% end %>
    <% else %>
      <span class="ocard-name"><%= subject.display_label %></span>
    <% end %>
    <% if champion && row.prob %>
      <span class="ocard-prob"><%= t(".market") %> <%= outright_market_pct(row.prob) %></span>
    <% elsif !champion && subject.meta&.dig("goals_at_lock") %>
      <span class="ocard-tag"><%= t(".goals", count: subject.meta["goals_at_lock"]) %></span>
    <% end %>
  </div>

  <div class="ocard-bar" aria-hidden="true">
    <% if total.positive? %>
      <span class="seg yes" style="flex-grow:<%= yes %>"></span>
      <span class="seg no" style="flex-grow:<%= no %>"></span>
    <% else %>
      <span class="seg empty"></span>
    <% end %>
  </div>
  <div class="ocard-counts">
    <span class="cy"><%= t(".yes") %> <b><%= bottles_count(yes) %></b> 🥤</span>
    <span class="cn"><b><%= bottles_count(no) %></b> 🥤 <%= t(".no") %></span>
  </div>

  <% if champion %>
    <div class="ocard-compare">
      <span><%= t(".market_win") %> <b><%= outright_market_pct(row.prob) || "—" %></b></span>
      <span><%= t(".crowd_favor") %> <b><%= outright_crowd_pct(tally) || "—" %></b></span>
    </div>
  <% end %>

  <% if row.outcome.present? %>
    <div class="ocard-result <%= row.outcome == "won_title" ? "win" : "out" %>">
      <span class="rbadge">
        <%= outright_result_label(market, row.outcome) %><%= row.outcome == "won_title" ? (champion ? " 👑" : " ⚽") : "" %>
      </span>
      <% if row.my_entry %>
        <span class="rmine <%= row.my_entry.won ? "w" : "l" %>">
          <%= t(".bet_verb") %><%= outright_pick_label(row.my_entry.pick) %> · <%= outright_delta_verb(row.my_entry.delta) %> <%= format("%.2f", row.my_entry.delta.abs) %> 🥤
        </span>
      <% end %>
    </div>
  <% elsif row.open %>
    <%# Open from the round of 32 until this team's own quarter-final. A team not
        yet slotted into a QF has no deadline, so it shows open without a countdown.
        Pick a side → a popover asks how many bottles → that button submits. The
        popover is absolutely positioned so it never shifts the card (no jitter). %>
    <div class="ocard-live"<% if row.deadline %> data-controller="countdown" data-countdown-closes-at-value="<%= row.deadline.iso8601 %>"<% end %>>
      <% if row.deadline %>
        <div class="ocard-deadline">⏳ <%= t(".until_lock") %> <b data-countdown-target="display"><%= outright_countdown_text(row.deadline) %></b> · <%= format_kickoff(row.deadline) %></div>
      <% else %>
        <div class="ocard-deadline">🟢 <%= t(".open_until_qf") %></div>
      <% end %>
      <%= form_with url: outright_picks_path, method: :post, class: "ocard-form" do %>
        <%= hidden_field_tag :market, market %>
        <%= hidden_field_tag :subject_key, subject.subject_key %>
        <div class="ocard-pick" data-controller="stake-popup">
          <label class="pbtn yes<%= " sel" if row.my_pick == "yes" %>">
            <input type="radio" name="pick" value="yes" autocomplete="off" data-action="change->stake-popup#open">
            <span><%= t(".yes") %></span>
            <small><%= row.my_pick == "yes" ? t(".staked", count: current_stake) : (champion ? t(".will_champion") : t(".will_golden_boot")) %></small>
          </label>
          <label class="pbtn no<%= " sel" if row.my_pick == "no" %>">
            <input type="radio" name="pick" value="no" autocomplete="off" data-action="change->stake-popup#open">
            <span><%= t(".no") %></span>
            <small><%= row.my_pick == "no" ? t(".staked", count: current_stake) : t(".will_not") %></small>
          </label>
          <div class="stake-pop">
            <span class="sp-label"><%= t(".stake_prompt") %></span>
            <div class="sp-opts">
              <% OutrightPick::STAKE_OPTIONS.each do |amount| %>
                <button type="submit" name="stake" value="<%= amount.to_i %>"
                        class="sp-btn<%= " sel" if row.my_pick && current_stake == amount.to_i %>"><%= t(".bottles", count: amount.to_i) %></button>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      <div class="ocard-foot">
        <% if row.my_pick %>
          <span class="hint"><%= t(".change_hint") %></span>
          <%= button_to t(".cancel"), outright_picks_path, method: :delete,
                params: { market: market, subject_key: subject.subject_key },
                class: "ocard-cancel", form: { style: "display:inline" } %>
        <% else %>
          <span class="hint"><%= t(".pick_hint") %></span>
        <% end %>
      </div>
    </div>
  <% elsif row.eliminated %>
    <div class="ocard-locked">🚫 <%= t(".eliminated") %></div>
  <% else %>
    <div class="ocard-locked">
      <% if row.my_pick %>
        🔒 <%= t(".locked_mine_html", pick: outright_pick_label(row.my_pick), count: current_stake) %>
      <% else %>
        🔒 <%= t(".locked_none") %>
      <% end %>
    </div>
  <% end %>

  <% if row.roster.any? %>
    <details class="ocard-who">
      <summary>👥 <%= t(".roster_summary", count: row.roster.size) %></summary>
      <div class="who-list">
        <% row.roster.each do |entry| %>
          <span class="who-item <%= entry.pick %>">
            <%= entry.user.emoji.presence || "🙂" %> <%= entry.user.nickname %>
            <b><%= outright_pick_label(entry.pick) %></b> · <%= t(".bottles", count: bottles_count(entry.stake)) %>
          </span>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
