<% content_for :title, t(".page_title") %>
<section>
  <div class="detail-head">
    <%= link_to root_path, class: "back-btn", data: { controller: "back", action: "click->back#go" } do %>
      <span class="bk-arrow">←</span> <%= t(".back") %>
    <% end %>
    <%= link_to t(".third_place_crumb"), third_place_path, class: "detail-crumb" %>
  </div>
  <hr class="rule ink">

  <div class="lbh">
    <h1 class="disp"><%= t(".heading") %></h1>
    <div class="sub"><%= t(".subtitle") %></div>
  </div>

  <% if @rows.empty? %>
    <p class="standings-empty"><%= t(".empty") %></p>
  <% else %>
    <div class="standings scorers">
      <div class="st-row st-head">
        <span class="st-rk">#</span>
        <span class="st-team"><%= t(".col_player") %></span>
        <span class="st-n st-pts" title="<%= t(".col_goals_title") %>"><%= t(".col_goals") %></span>
        <span class="st-n" title="<%= t(".col_penalties_title") %>"><%= t(".col_penalties") %></span>
      </div>
      <div id="scorer_rows">
        <%= render partial: "scorers/row", collection: @rows, as: :row, locals: { offset: @offset } %>
        <% if @next_page %>
          <div class="scroll-sentinel" data-controller="infinite-scroll"
               data-infinite-scroll-url-value="<%= scorers_path(page: @next_page) %>"></div>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
