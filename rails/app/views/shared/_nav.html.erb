<%
  user = signed_in_user
  tabs = [ { href: "/", icon: "⚽", label: t(".tab_schedule") } ]
  # The champion tab appears the moment the first round-of-16 team is known.
  tabs << { href: "/predictions", icon: "👑", label: t(".tab_champion") } if Champion.available?
  tabs += [
    { href: "/leaderboard", icon: "🏆", label: t(".tab_leaderboard") },
    { href: "/me",          icon: "🥤", label: t(".tab_redeem") },
    { href: "/about",       icon: "📖", label: t(".tab_about") }
  ]
  tabs << { href: "/admin", icon: "⚙️", label: t(".tab_admin") } if user&.settler?
%>
<header class="site-head">
  <div class="shell">
    <div class="bar">
      <%= link_to "/", class: "wm" do %>
        <span class="wm-pre">The Cola of Cup</span>
        <span class="yr">2026</span>
      <% end %>
      <nav class="nav">
        <% tabs.each do |tab| %>
          <%= link_to tab[:href], class: ("on" if nav_tab_active?(tab[:href])) do %>
            <span class="ic"><%= tab[:icon] %></span><%= tab[:label] %>
          <% end %>
        <% end %>
      </nav>
      <div class="head-right">
        <%= render "shared/locale_switcher" %>
        <% if user %>
          <%= link_to me_settings_path, class: "identity" do %>
            <%= user.emoji || "👤" %> <%= user.nickname %>
          <% end %>
        <% else %>
          <%= link_to t(".sign_in"), "/identity", class: "identity" %>
        <% end %>
      </div>
    </div>
  </div>
</header>

<nav class="tabbar">
  <% tabs.each do |tab| %>
    <%= link_to tab[:href], class: ("on" if nav_tab_active?(tab[:href])) do %>
      <span class="ic"><%= tab[:icon] %></span><%= tab[:label] %>
    <% end %>
  <% end %>
</nav>
