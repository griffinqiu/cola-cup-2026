<section class="id-page">
  <h1><%= t(".heading") %></h1>
  <% @accounts.each do |account| %>
    <p class="lead"><%= t(".logged_in_with", provider: provider_label(account.provider)) %><% if account.username.present? %> · @<%= account.username %><% end %></p>
  <% end %>

  <%= render "profiles/form", user: current_user %>

  <div class="id-locale">
    <label class="row"><%= t("locale_switcher.label") %></label>
    <%= render "shared/locale_switcher" %>
  </div>

  <%= button_to t(".sign_out"), destroy_user_session_path, method: :delete, form: { class: "signout" } %>
</section>
