<div id="redeem_panel" class="redeem">
  <div class="redeem-tip">
    <p class="redeem-pickup"><%= t(".pickup") %></p>
    <p class="redeem-free"><%= t(".free_html") %></p>
  </div>
  <% Drink::ALL.each do |drink| %>
    <%= form_with url: redemptions_path, method: :post, class: "rdrink",
                  data: { controller: "qty-stepper", qty_stepper_cost_value: drink.cost } do |form| %>
      <span class="em"><%= drink.emoji %></span>
      <span class="meta">
        <div class="dn"><%= drink.name %></div>
        <div class="price"><%= t(".credits_per_bottle", credits: format_credits(drink.cost)) %></div>
      </span>
      <span class="stepper">
        <button type="button" data-action="qty-stepper#dec" data-qty-stepper-target="dec" aria-label="<%= t(".decrease") %>">−</button>
        <b data-qty-stepper-target="qty">1</b>
        <button type="button" data-action="qty-stepper#inc" aria-label="<%= t(".increase") %>">＋</button>
      </span>
      <%= form.hidden_field :drink, value: drink.key %>
      <%= form.hidden_field :qty, value: 1, data: { qty_stepper_target: "qtyInput" } %>
      <button type="submit" class="rbtn" data-qty-stepper-target="submit"><%= t(".redeem", credits: format_credits(drink.cost)) %></button>
    <% end %>
  <% end %>

  <% if local_assigns[:error].present? %>
    <p class="formerror"><%= error %></p>
  <% end %>
</div>
