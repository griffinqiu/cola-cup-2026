<section>
  <%= turbo_stream_from current_user, "ledger", I18n.locale %>
  <div class="me">
    <div class="who">
      <span class="em"><%= current_user.emoji || "👤" %></span>
      <span>
        <div class="nm disp"><%= current_user.nickname %></div>
        <div class="tag"><%= t(".participation", count: @ledger.size, wins: @wins) %></div>
      </span>
    </div>
    <hr class="rule ink" style="margin-top: 18px">
    <div class="balstats">
      <div class="bstat">
        <div class="netlbl"><%= t(".total_won") %></div>
        <div class="bv <%= @total.positive? ? "pos" : @total.negative? ? "neg" : "zero" %>"><%= format_bottles(@total) %></div>
      </div>
      <div class="bstat">
        <div class="netlbl"><%= t(".redeemed") %></div>
        <%= render "profiles/redeemed", redeemed: @redeemed %>
      </div>
    </div>
    <div class="netlbl"><%= t(".available_credit") %></div>
    <%= render "profiles/balance", balance: @balance %>
    <p class="note"><%= t(".available_credit_note") %></p>
  </div>

  <hr class="rule">
  <%= render "profiles/redeem_panel" %>

  <%= render "profiles/redemption_records", redemptions: @redemptions %>

  <div class="ledh disp"><%= t(".ledger_heading") %></div>
  <hr class="rule">
  <% if @ledger.empty? %>
    <p style="padding:32px 0;text-align:center;color:var(--low);font-size:13px"><%= t(".empty_ledger") %></p>
  <% else %>
    <%= render "profiles/ledger", ledger: @ledger %>
  <% end %>
</section>
