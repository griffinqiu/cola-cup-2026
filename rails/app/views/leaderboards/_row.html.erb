<% rank = offset + entry_counter + 1 %>
<% bets = entry.bets.to_i %>
<% wins = entry.wins.to_i %>
<% total = entry.total.to_f %>
<% redeemed = entry.redeemed.to_f %>
<% mean = local_assigns.fetch(:mean, nil) %>
<% hit_pct = bets > 0 ? (wins.fdiv(bets) * 100).round : nil %>
<% rank_score = board_rank_score(board, entry, mean) %>
<% leader = rank == 1 && bets > 0 %>
<% total_class = total > 0 ? "b pos" : total < 0 ? "b neg" : "b zero" %>
<div id="lb_user_<%= entry.id %>" data-user-id="<%= entry.id %>">
  <%= link_to user_path(entry), class: (leader ? "lr leader" : "lr") do %>
    <span class="rk"><%= rank %></span>
    <span class="em"><%= entry.emoji || "👤" %></span>
    <span class="who">
      <div class="nm"><%= entry.nickname %></div>
      <div class="m"><%= t(".bets_wins", bets: bets, wins: wins) %><% if bets > 0 %><%= t(".hit_suffix", hit_pct: hit_pct) %><% end %></div>
    </span>
    <span class="n">
      <% case board.metric %>
      <% when :hit_rate %>
        <div class="b pos"><span class="lbl"><%= t(".prophet_score") %></span><%= rank_score ? format('%.1f', rank_score) : "—" %></div>
        <div class="st"><%= t(".hit_rate", value: hit_pct ? "#{hit_pct}%" : "—") %></div>
      <% when :miss_rate %>
        <div class="b neg"><span class="lbl"><%= t(".jinx_score") %></span><%= rank_score ? format('%.1f', rank_score) : "—" %></div>
        <div class="st"><%= t(".miss_rate", value: hit_pct ? "#{100 - hit_pct}%" : "—", misses: bets - wins, bets: bets) %></div>
      <% when :redeemed %>
        <div class="b pos"><span class="lbl"><%= t(".redeemed") %></span><%= format('%.1f', redeemed) %></div>
        <div class="st"><%= t(".record", value: format_bottles(total)) %></div>
      <% else %>
        <div class="<%= total_class %>"><span class="lbl"><%= t(".record_label") %></span><%= format_bottles(total) %></div>
        <% if redeemed > 0 %>
          <div class="st hint" title="<%= t(".redeemed_excluded_title") %>"><%= t(".redeemed_short", value: format('%.1f', redeemed)) %></div>
        <% else %>
          <div class="st"><%= t(".not_redeemed") %></div>
        <% end %>
      <% end %>
    </span>
  <% end %>
  <hr class="rule">
</div>
