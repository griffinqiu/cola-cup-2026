<% content_for :title, t(".page_title") %>
<section>
  <div class="detail-head">
    <%= link_to root_path, class: "back-btn", data: { controller: "back", action: "click->back#go" } do %>
      <span class="bk-arrow">←</span> <%= t(".back") %>
    <% end %>
    <%= link_to t(".scorers_crumb"), scorers_path, class: "detail-crumb" %>
  </div>
  <hr class="rule ink">

  <div class="lbh">
    <h1 class="disp"><%= t(".heading") %></h1>
    <div class="sub"><%= t(".subtitle", slots: @slots) %></div>
  </div>

  <% if @entries.empty? %>
    <p class="standings-empty"><%= t(".empty") %></p>
  <% else %>
    <div class="standings third-place">
      <div class="st-row st-head">
        <span class="st-rk">#</span>
        <span class="st-grp"><%= t(".col_group") %></span>
        <span class="st-team"><%= t(".col_team") %></span>
        <span class="st-n" title="<%= t(".col_played_title") %>"><%= t(".col_played") %></span>
        <span class="st-n st-gd" title="<%= t(".col_goal_diff_title") %>"><%= t(".col_goal_diff") %></span>
        <span class="st-n" title="<%= t(".col_goals_for_title") %>"><%= t(".col_goals_for") %></span>
        <span class="st-n st-pts" title="<%= t(".col_points_title") %>"><%= t(".col_points") %></span>
      </div>
      <% @entries.each do |entry| %>
        <% if entry.rank == @slots + 1 %>
          <div class="st-cutline"><span><%= t(".cutline") %></span></div>
        <% end %>
        <%= link_to group_path(entry.letter), class: "st-row #{entry.qualified ? "qual" : "out"}" do %>
          <span class="st-rk num"><%= entry.rank %></span>
          <span class="st-grp"><%= entry.letter %></span>
          <span class="st-team">
            <span class="flag"><%= row_flag(entry.row) %></span>
            <span class="nm"><%= entry.row.display_name %></span>
          </span>
          <span class="st-n num"><%= entry.row.played %></span>
          <span class="st-n st-gd num"><%= format_goal_diff(entry.row.goal_diff) %></span>
          <span class="st-n num"><%= entry.row.goals_for %></span>
          <span class="st-n st-pts num"><%= entry.row.points %></span>
        <% end %>
      <% end %>
    </div>
    <div class="st-legend">
      <span><i class="dot qual"></i><%= t(".legend_qualified") %></span>
      <span><i class="dot out"></i><%= t(".legend_out") %></span>
    </div>
  <% end %>
</section>
