<% link_style = "display:block;text-align:center;text-decoration:none" %>
<% case @reason && @reason[:kind] %>
<% when :suspended %>
  <section class="id-page">
    <h1 class="disp"><%= t(".suspended_heading_html") %></h1>
    <p class="lead">
      <%= t(".suspended_body1") %>
    </p>
    <p class="lead">
      <%= t(".suspended_body2") %>
    </p>
    <%= link_to t(".back_to_sign_in"), identity_path, class: "cta", style: link_style %>
  </section>
<% when :rate_limited %>
  <section class="id-page">
    <h1 class="disp"><%= t(".rate_limited_heading_html") %></h1>
    <p class="lead">
      <%= t(".rate_limited_body1") %>
    </p>
    <p class="lead">
      <%= t(".rate_limited_body2_html", reset_time: format_reset_time(@reason[:reset_epoch])) %>
    </p>
    <%= link_to t(".back_to_sign_in"), identity_path, class: "cta", style: link_style %>
  </section>
<% else %>
  <section class="id-page">
    <h1 class="disp"><%= t(".error_heading_html") %></h1>
    <p class="lead">
      <%= t(".error_body1_html") %>
    </p>
    <p class="lead">
      <%= t(".error_body2") %>
    </p>
    <%= link_to t(".sign_in_again"), identity_path, class: "cta", style: link_style %>
  </section>
<% end %>
