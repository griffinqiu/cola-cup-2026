<% big = match_card_big(match, tally, market) %>
<div class="big" id="match_card_big_<%= match.id %>">
  <% case big[:kind] %>
  <% when :result %>
    <div class="pct score"><%= big[:label] %></div>
    <% if big[:cap] %>
      <div class="cap"><%= big[:cap] %></div>
    <% end %>
  <% when :market %>
    <div class="srclbl"><%= t(".market") %>·<%= big[:short] %></div>
    <div class="pct"><%= big[:pct] %>%</div>
    <% if (dv = big[:divergence]) %>
      <div class="dv hot <%= dv[:tone] %>"><%= dv[:text] %></div>
    <% end %>
  <% when :crowd %>
    <div class="srclbl cr"><%= t(".colleagues") %>·<%= big[:short] %></div>
    <div class="pct"><%= big[:pct] %>%</div>
    <div class="cap"><%= big[:cap] %></div>
  <% else %>
    <div class="cap"><%= t(".no_odds") %></div>
  <% end %>
</div>
