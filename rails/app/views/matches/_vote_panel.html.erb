<% has_identity = current_user.present? %>
<% votable = status == :open %>
<% error = local_assigns[:error] %>
<div class="vp" id="vote_panel_<%= match.id %>">
  <% if match.result.present? || match.goals.exists? %>
    <%# Match over: the lock / your-pick text is moot, so this panel becomes the
        match's goal log (scorer · minute · team) plus a link to the full
        top-scorer board. Goals come from openfootball and can lag the score,
        hence the 待更新 fallback. Shown to everyone, signed in or not. %>
    <h2 class="disp"><%= t(".match_goals") %></h2>
    <% goal_log = match.goal_log %>
    <% if goal_log.any? %>
      <ul class="goal-log">
        <% goal_log.each do |g| %>
          <li>
            <span class="flag"><%= g.team&.flag.presence || "🏳️" %></span>
            <span class="who"><%= g.player_name %></span>
            <% if g.own_goal %><span class="gtag og"><%= t(".own_goal") %></span><% elsif g.penalty %><span class="gtag pk"><%= t(".penalty") %></span><% end %>
            <% if g.minute %><span class="min"><%= g.minute %>'</span><% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="signed-lock"><%= t(".goals_pending") %></p>
    <% end %>
    <%= link_to t(".scorers_link"), scorers_path, class: "cand-more" %>
  <% elsif !has_identity %>
    <h2 class="disp"><%= t(".want_to_predict") %></h2>
    <p class="signed-lock">
      <%= t(".set_identity_prefix") %> <%= link_to t(".set_identity_link"), identity_path, style: "color: var(--red); border-bottom: 1px solid color-mix(in srgb,var(--red) 45%,transparent)" %><%= t(".set_identity_suffix") %>
    </p>
  <% elsif !votable %>
    <h2 class="disp"><%= user_vote ? t(".locked") : t(".not_open") %></h2>
    <p class="signed-lock">
      <% if user_vote %>
        🔒 <%= t(".you_picked_prefix") %> <b><%= pick_team_label(match, user_vote.pick) %></b> · <%= bottles_count(user_vote.stake) %> <%= t(".bottles_suffix") %>
      <% else %>
        🔒 <%= t(".cannot_predict") %>
      <% end %>
    </p>
  <% else %>
    <% picks = match.valid_picks %>
    <% current_pick = user_vote&.pick %>
    <% current_stake = user_vote&.stake || match.default_stake %>
    <% stake_options = match.stake_options %>
    <% pool = preview_pool(match, tally, user_vote) %>
    <% preview_odds = preview_odds_by_pick(match, tally, current_pick, stake: current_stake) %>
    <% decimal = current_pick ? preview_odds[current_pick] : nil %>
    <% potential = (decimal && decimal.finite?) ? current_stake * (decimal - 1) : nil %>
    <div data-controller="vote-panel countdown"
         data-vote-panel-confirmed-value="<%= current_pick %>"
         data-vote-panel-confirmed-stake-value="<%= user_vote&.stake %>"
         data-vote-panel-default-stake-value="<%= match.default_stake %>"
         data-vote-panel-others-total-value="<%= pool[:others_total] %>"
         data-countdown-closes-at-value="<%= match.vote_closes_at.iso8601 %>">
      <h2 class="disp"><%= t(".who_do_you_pick") %></h2>
      <%= form_with url: match_vote_path(match), method: :post do %>
        <%= hidden_field_tag :pick, current_pick, data: { vote_panel_target: "pickInput" } %>
        <%= hidden_field_tag :stake, current_stake, data: { vote_panel_target: "stakeInput" } %>
        <div class="picks<%= " two" if picks.size == 2 %>">
          <% picks.each do |key| %>
            <% label = pick_team_label(match, key) %>
            <button type="button" class="p<%= " sel" if current_pick == key %>"
                    style="font-size: <%= pick_label_font_px(label) %>px"
                    data-vote-panel-target="pick" data-pick="<%= key %>"
                    data-others="<%= pool[:by_pick][key] %>"
                    data-label="<%= label %>"
                    data-action="vote-panel#select"><%= label %></button>
          <% end %>
        </div>

        <% if stake_options.size > 1 %>
          <div class="stakes">
            <% stake_options.each do |amount| %>
              <button type="button" class="s<%= " sel" if current_stake == amount %>"
                      data-vote-panel-target="stake" data-stake="<%= amount %>"
                      data-action="vote-panel#selectStake"><%= bottles_count(amount) %> <%= t(".bottles") %></button>
            <% end %>
          </div>
          <p class="changenote" style="text-align:left;color:var(--mid);font-size:13px;padding:14px 0 0">
            <%= t(".choose_stake_hint") %>
          </p>
        <% else %>
          <p class="changenote" style="text-align:left;color:var(--mid);font-size:13px;padding:18px 0 0">
            <%= t(".fixed_stake_prefix") %> <b><%= bottles_count(current_stake) %> <%= t(".bottles") %></b> <%= t(".fixed_stake_suffix") %>
          </p>
        <% end %>

        <p class="pot" data-vote-panel-target="pot">
          <% if potential %>
            <%= t(".win_prefix") %> <b>+<%= format("%.1f", potential) %> <%= t(".bottles") %></b> <%= t(".win_suffix") %>
          <% else %>
            <%= t(".pick_one") %>
          <% end %>
        </p>

        <% if error %><p class="formerror"><%= error %></p><% end %>

        <%# Outline + disabled until the picker selects something other than the
            saved pick; vote-panel#render flips it to the red fill when actionable. %>
        <button type="submit" class="cta outline" data-vote-panel-target="submit" disabled>
          <%= current_pick ? t(".submit_voted", team: pick_team_label(match, current_pick)) : t(".submit_pick_one") %>
        </button>
      <% end %>

    </div>
  <% end %>

  <%# Match-to-match navigation shows in every state (locked / over / signed-out
      too); the change-or-cancel hint only while a vote is still open. %>
  <div class="vp-foot">
    <% if next_match_id %>
      <%= link_to match_path(next_match_id), class: "vp-back" do %><%= t(".next_match") %> <span class="bk-arrow">→</span><% end %>
    <% else %>
      <%= link_to root_path(anchor: "match_card_#{match.id}"), class: "vp-back" do %><span class="bk-arrow">←</span> <%= t(".back_to_schedule") %><% end %>
    <% end %>
    <% if votable %>
      <span class="vp-hint"><%= t(".change_hint") %><% if user_vote %><%= button_to t(".cancel_vote"), match_vote_path(match), method: :delete, class: "vp-cancel-link", form: { style: "display:inline" } %><% else %><%= t(".cancel_vote") %><% end %></span>
    <% end %>
  </div>
</div>
